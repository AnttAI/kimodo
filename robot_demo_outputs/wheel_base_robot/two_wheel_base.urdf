<?xml version="1.0"?>
<robot name="two_wheel_base">
  <!-- Dimensions: wheel diameter 0.20 m, wheel center separation 0.38 m. -->

  <material name="shell_graphite">
    <color rgba="0.19 0.23 0.27 1.0"/>
  </material>
  <material name="bumper_black">
    <color rgba="0.025 0.027 0.030 1.0"/>
  </material>
  <material name="tire_black">
    <color rgba="0.005 0.005 0.005 1.0"/>
  </material>
  <material name="rim_metal">
    <color rgba="0.68 0.72 0.74 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.0323" ixy="0" ixz="0" iyy="0.1320" iyz="0" izz="0.1493"/>
    </inertial>
    <visual name="base_shell">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_shell.ply"/>
      </geometry>
    </visual>
    <visual name="left_wheel_fender">
      <origin xyz="0 0.155 0.10" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_fender.stl"/>
      </geometry>
      <material name="bumper_black"/>
    </visual>
    <visual name="right_wheel_fender">
      <origin xyz="0 -0.155 0.10" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_fender.stl"/>
      </geometry>
      <material name="bumper_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.13" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.30 0.13"/>
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.75"/>
      <inertia ixx="0.00203" ixy="0" ixz="0" iyy="0.00375" iyz="0" izz="0.00203"/>
    </inertial>
    <visual name="left_tire">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_tire.stl"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="left_treads">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_treads.stl"/>
      </geometry>
      <material name="bumper_black"/>
    </visual>
    <visual name="left_rim">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_rim.stl"/>
      </geometry>
      <material name="rim_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.75"/>
      <inertia ixx="0.00203" ixy="0" ixz="0" iyy="0.00375" iyz="0" izz="0.00203"/>
    </inertial>
    <visual name="right_tire">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_tire.stl"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="right_treads">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_treads.stl"/>
      </geometry>
      <material name="bumper_black"/>
    </visual>
    <visual name="right_rim">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_rim.stl"/>
      </geometry>
      <material name="rim_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.19 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.19 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
